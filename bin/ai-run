#!/usr/bin/env python3
import json
import os
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import uuid

TIMEOUT = 60
MODELS_DEV = os.path.expanduser("~/.cache/omarchy-ai-menu/models-dev.json")


def emit(session, text):
    if text:
        print(json.dumps({"type": "text", "sessionID": session,
                          "part": {"text": text}}, separators=(",", ":")), flush=True)


def emit_thinking(session, text):
    if text:
        print(json.dumps({"type": "thinking", "sessionID": session,
                          "part": {"text": text}}, separators=(",", ":")), flush=True)


def emit_usage(session, used, limit):
    if used:
        print(json.dumps({"type": "usage", "sessionID": session,
                          "part": {"used": used, "limit": limit}}, separators=(",", ":")), flush=True)


# Janela de contexto do modelo via models.dev (mesma fonte que o opencode
# usa), com cache local de 7 dias. Match exato ou por prefixo mais longo.
def models_dev_context(model_id):
    try:
        data = {}
        if os.path.exists(MODELS_DEV) and time.time() - os.path.getmtime(MODELS_DEV) < 7 * 86400:
            data = json.loads(open(MODELS_DEV).read())
        if not data:
            os.makedirs(os.path.dirname(MODELS_DEV), exist_ok=True)
            data = json.loads(urllib.request.urlopen("https://models.dev/api.json", timeout=10).read())
            open(MODELS_DEV, "w").write(json.dumps(data))
        needle = model_id.lower()
        best = 0
        for prov in data.values():
            for mid, m in (prov.get("models") or {}).items():
                low = mid.lower()
                if needle == low or needle.startswith(low + "-") or low.startswith(needle):
                    best = max(best, int((m.get("limit") or {}).get("context") or 0))
        return best
    except Exception:
        return 0


def command(harness, model, effort, session, prompt, yolo):
    if harness == "codex":
        sandbox = "danger-full-access" if yolo else "read-only"
        if session:
            args = ["codex", "exec", "resume", session, "--json", "--skip-git-repo-check",
                    "--ignore-rules", "-m", model, "-c", 'approval_policy="never"']
        else:
            args = ["codex", "exec", "--json", "--skip-git-repo-check", "--ignore-rules",
                    "-C", os.path.expanduser("~"), "-m", model,
                    "-c", 'approval_policy="never"', "-s", sandbox]
        if yolo and session:
            args += ["-s", sandbox]
        if effort != "default":
            args += ["-c", f'model_reasoning_effort="{effort}"']
        return args + [prompt], None
    if harness == "claude":
        args = ["claude", "-p", "--output-format", "stream-json", "--verbose",
                "--include-partial-messages", "--model", model]
        if yolo:
            args += ["--dangerously-skip-permissions"]
        else:
            args += ["--restricted", "--tools", ""]
        if effort != "default":
            args += ["--effort", effort]
        if session:
            args += ["--resume", session]
        else:
            args += ["--session-id", str(uuid.uuid4())]
        return args + [prompt], None
    if harness == "omp":
        args = ["omp", "-p", "--mode", "json", "--max-time", str(TIMEOUT), "--model", model]
        if not yolo:
            args += ["--no-tools", "--no-extensions", "--no-skills", "--no-rules"]
        else:
            args += ["--approval-mode", "yolo"]
        if effort != "default":
            args += ["--thinking", effort]
        if session:
            args += ["--resume", session]
        return args + [prompt], None
    raise ValueError("unsupported harness")


# Each handler consumes one stdout line of the harness stream and emits text
# deltas in the OpenCode event shape the Assistant already parses.
def codex_handler(session, state):
    def line(raw):
        try:
            event = json.loads(raw)
        except ValueError:
            return
        if event.get("type") == "thread.started":
            session.append(event.get("thread_id") or session[-1])
        if event.get("type") == "token_count":
            info = event.get("info") or {}
            counts = info.get("total_token_counts") or info
            used = int(counts.get("input_tokens") or 0) + int(counts.get("output_tokens") or 0)
            if used > state.get("used", 0):
                state["used"] = used
        item = event.get("item") or {}
        if event.get("type") == "item.completed" and item.get("type") == "agent_message":
            text = (item.get("text") or "").strip()
            if text:
                state["emitted"] = True
                emit(session[-1], text)
    return line


def claude_handler(session, state):
    def line(raw):
        try:
            event = json.loads(raw)
        except ValueError:
            return
        kind = event.get("type")
        if kind == "system" and event.get("subtype") == "init":
            session.append(event.get("session_id") or session[-1])
        elif kind == "stream_event":
            event_body = event.get("event") or {}
            if event_body.get("type") == "content_block_delta":
                delta = event_body.get("delta") or {}
                if delta.get("type") == "thinking_delta" and delta.get("thinking"):
                    emit_thinking(session[-1], delta["thinking"])
                elif delta.get("text"):
                    state["emitted"] = True
                    emit(session[-1], delta["text"])
        elif kind == "result" and not state["emitted"]:
            text = (event.get("result") or "").strip()
            if text:
                state["emitted"] = True
                emit(session[-1], text)
        if kind == "result":
            usage = event.get("modelUsage") or {}
            for entry in usage.values():
                state["limit"] = int(entry.get("contextWindow") or 0) or state["limit"]
                break
            u = event.get("usage") or {}
            used = sum(int(u.get(k) or 0) for k in ("input_tokens", "output_tokens",
                                                    "cache_read_input_tokens", "cache_creation_input_tokens"))
            if used > state.get("used", 0):
                state["used"] = used
    return line


def omp_handler(session, state):
    def line(raw):
        try:
            event = json.loads(raw)
        except ValueError:
            return
        kind = event.get("type")
        if kind == "session":
            session.append(event.get("id") or session[-1])
        elif kind == "message_update":
            body = event.get("assistantMessageEvent") or {}
            body_kind = body.get("type")
            if body_kind == "text_delta" and body.get("delta"):
                state["emitted"] = True
                emit(session[-1], body["delta"])
            elif body_kind == "thinking_delta" and body.get("delta"):
                emit_thinking(session[-1], body["delta"])
        elif kind == "message_end":
            message = event.get("message") or {}
            if message.get("role") == "assistant":
                usage = message.get("usage") or {}
                total = int(usage.get("totalTokens") or 0)
                if total > state.get("used", 0):
                    state["used"] = total
                if not state["emitted"]:
                    content = message.get("content") or []
                    text = "".join(block.get("text", "") for block in content
                                   if isinstance(block, dict) and block.get("type") == "text").strip()
                    if text:
                        state["emitted"] = True
                        emit(session[-1], text)
    return line


HANDLERS = {"codex": codex_handler, "claude": claude_handler, "omp": omp_handler}


def fallback(session, raw_lines):
    # No known event matched: surface the raw output instead of silence.
    output = "".join(raw_lines).strip()
    if not output:
        return
    try:
        event = json.loads(output)
        output = str(event.get("result") or event.get("response") or event.get("text") or output)
    except ValueError:
        pass
    emit(session[-1], output)


def run_cli(harness, model, effort, session, prompt, yolo):
    args, env = command(harness, model, effort, session, prompt, yolo)
    process = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                               text=True, env=env)
    timed_out = False

    def kill():
        nonlocal timed_out
        timed_out = True
        process.kill()

    watchdog = threading.Timer(TIMEOUT, kill)
    watchdog.start()
    session_id = [session]
    state = {"emitted": False, "used": 0, "limit": 0}
    handler = HANDLERS[harness](session_id, state)
    raw = []
    for line in process.stdout:
        raw.append(line)
        handler(line)
    watchdog.cancel()
    process.wait()
    if timed_out:
        raise SystemExit(124)
    if process.returncode:
        raise SystemExit(process.returncode)
    if state["limit"] == 0:
        state["limit"] = models_dev_context(model)
    emit_usage(session_id[-1], state["used"], state["limit"])
    if not state["emitted"]:
        fallback(session_id, raw)


def opencode_config(yolo):
    permission = "allow" if yolo else "deny"
    return ('{"agent":{"omarchy-help":{"description":"Answers Omarchy system questions",'
            '"mode":"primary","permission":{"*":"' + permission + '"}}}}')


def opencode_main(model, effort, session, prompt, yolo):
    del effort  # opencode has no effort knob in this flow
    env = dict(os.environ, OPENCODE_CONFIG_CONTENT=opencode_config(yolo))
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        port = sock.getsockname()[1]
    server = subprocess.Popen(["opencode", "serve", "--port", str(port)],
                              cwd=os.path.expanduser("~"), stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, env=env)
    timed_out = False

    def kill():
        nonlocal timed_out
        timed_out = True
        server.kill()

    watchdog = threading.Timer(TIMEOUT, kill)
    watchdog.start()
    debug = open("/tmp/airun-debug.log", "w")

    def log(message):
        debug.write("%.3f %s\n" % (time.time(), message))
        debug.flush()

    try:
        base = "http://127.0.0.1:%d" % port
        log("serve spawned port=%d pid=%d" % (port, server.pid))
        for _ in range(80):
            try:
                urllib.request.urlopen(base + "/session", timeout=1).read()
                log("ready")
                break
            except urllib.error.HTTPError as error:
                log("ready http %s" % error.code)
                break
            except Exception as error:
                if timed_out:
                    log("timeout during readiness")
                    return
                log("readiness wait %r" % (error,))
                time.sleep(0.15)
        else:
            raise SystemExit("opencode server did not start")
        sid = session
        if not sid:
            request = urllib.request.Request(base + "/session", data=b"{}",
                                             headers={"Content-Type": "application/json"},
                                             method="POST")
            sid = json.loads(urllib.request.urlopen(request, timeout=10).read())["id"]
        log("session %s" % sid)
        state = {"emitted": False, "seen": {}, "used": 0, "limit": 0}
        failure = []

        def poster():
            provider, _, model_id = model.partition("/")
            body = json.dumps({"providerID": provider or "opencode", "modelID": model_id or model,
                               "agent": "omarchy-help",
                               "parts": [{"type": "text", "text": prompt}]}).encode()
            request = urllib.request.Request(base + "/session/%s/message" % sid, data=body,
                                             headers={"Content-Type": "application/json"},
                                             method="POST")
            try:
                urllib.request.urlopen(request, timeout=TIMEOUT).read()
                log("post done")
            except Exception as error:
                body_text = error.read().decode(errors="replace") if hasattr(error, "read") else str(error)
                failure.append(body_text or str(error))
                log("post failed %r" % (error,))

        def forward(part, kind, emit_fn):
            # Emit the not-yet-seen suffix of a part. Live deltas and
            # completion snapshots both land here, so neither duplicates
            # nor drops text.
            if part.get("type") != kind:
                return
            text = part.get("text") or ""
            key = part.get("id") or ""
            sent = state["seen"].get(key, 0)
            if len(text) > sent:
                state["seen"][key] = len(text)
                if kind == "text":
                    state["emitted"] = True
                emit_fn(sid, text[sent:])

        events = urllib.request.urlopen(base + "/event", timeout=3)
        log("sse open")
        poster_thread = threading.Thread(target=poster, daemon=True)
        poster_thread.start()
        deltas = 0
        part_kinds = {}
        while poster_thread.is_alive():
            try:
                line = events.readline().decode(errors="replace").strip()
            except Exception as error:
                log("sse read error %r" % (error,))
                continue
            if not line.startswith("data:"):
                continue
            try:
                event = json.loads(line[5:])
            except ValueError:
                continue
            kind = event.get("type")
            properties = event.get("properties") or {}
            if kind == "message.part.updated":
                # Snapshots carry the authoritative part type; delta events
                # always say field=text, even for reasoning parts.
                part = properties.get("part") or {}
                if part.get("id"):
                    part_kinds[part["id"]] = part.get("type") or "text"
                continue
            if kind != "message.part.delta":
                continue
            if properties.get("sessionID") != sid:
                continue
            key = properties.get("partID") or ""
            part_kind = part_kinds.get(key, "text")
            delta = properties.get("delta") or ""
            if delta:
                deltas += 1
                if deltas == 1:
                    log("first delta part=%s kind=%s" % (str(key)[-6:], part_kind))
                state["seen"][key] = state["seen"].get(key, 0) + len(delta)
                if part_kind == "text":
                    state["emitted"] = True
                    emit(sid, delta)
                else:
                    emit_thinking(sid, delta)
        log("sse ended deltas=%d emitted=%s failure=%s" % (deltas, state["emitted"], bool(failure)))
        # The message POST returns when the whole run is done; the session's
        # message list is the authoritative final content, covering parts that
        # never delta-streamed (post-tool text arrives as snapshots).
        messages = json.loads(urllib.request.urlopen(base + "/session/%s/message" % sid,
                                                     timeout=10).read())
        for message in messages:
            info = message.get("info") or message
            if info.get("role") != "assistant":
                continue
            tokens = (info.get("tokens") or {}).get("total") or 0
            if tokens > state["used"]:
                state["used"] = tokens
            if info.get("error"):
                sys.stderr.write(json.dumps(info["error"]) + "\n")
            for part in message.get("parts") or []:
                forward(part, "text", emit)
                forward(part, "reasoning", emit_thinking)
        if state["limit"] == 0:
            _, _, model_id = model.partition("/")
            state["limit"] = models_dev_context(model_id or model)
        emit_usage(sid, state["used"], state["limit"])
        log("tail done emitted=%s used=%d limit=%d" % (state["emitted"], state["used"], state["limit"]))
        if timed_out:
            raise SystemExit(124)
        if not state["emitted"]:
            if failure:
                sys.stderr.write(failure[0])
            raise SystemExit(1)
    finally:
        watchdog.cancel()
        server.terminate()
        try:
            server.wait(2)
        except Exception:
            server.kill()
        debug.close()


def main():
    if len(sys.argv) != 7:
        raise SystemExit("usage: ai-run HARNESS MODEL EFFORT SESSION YOLO PROMPT")
    harness, model, effort, session, yolo, prompt = sys.argv[1:]
    if harness == "opencode":
        opencode_main(model, effort, session, prompt, yolo == "on")
        return
    run_cli(harness, model, effort, session, prompt, yolo == "on")


if __name__ == "__main__":
    main()
